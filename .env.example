# ── Sejlplan konfiguration ────────────────────────────────
# Kopier denne fil til ".env" og udfyld værdierne.
# .env må ALDRIG committes til git (den står i .gitignore).

# Anthropic API-nøgle til AI-sejlanalysen.
# Hentes på https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model der bruges til analysen.
SEJLPLAN_AI_MODEL=claude-opus-5

# Hemmelighed der signerer browser-sessioner. Skal være en lang,
# tilfældig streng. Skift den, og alle brugere logges "ud" af deres
# gemte indstillinger.
SEJLPLAN_STORAGE_SECRET=skift-mig-til-noget-langt-og-tilfaeldigt

# Netværk
SEJLPLAN_HOST=0.0.0.0
SEJLPLAN_PORT=8090

# Kontakt-mail sendt med i User-Agent til OpenStreetMap Nominatim
# (deres brugsvilkår kræver en identificerbar afsender).
SEJLPLAN_CONTACT=din@mail.dk

# ── Fællesskabet ──────────────────────────────────────────
# De tre funktioner, der kræver, at der er andre derude. Er de
# lukkede, findes de slet ikke: ingen knapper, ingen kortlag, og
# ingen afsnit i manualen. Teksterne bliver stående i koden, så de
# er oversat den dag, du åbner.
#
# Standarden er lukket. Sæt =til (eller 1/ja/true/on) for at åbne.
# Alt andet er et nej — også en stavefejl.
#
# Åbn dem én ad gangen. De har ikke samme tærskel: en pladsmelding
# hjælper den næste, der kommer til havnen, allerede når I er få,
# mens bådene på kortet først giver mening, når der er nogen at se.
# En flåde med én båd i fortæller den første bruger, at han er alene.

# "Meld plads" — god plads, få pladser, fuld. Den med lavest tærskel.
SEJLPLAN_PLADSMELDING=fra

# "Vis min båd for andre" og listen over både i nærheden.
SEJLPLAN_FLAADE=fra

# Beskeder mellem både. Kræver at flåden også er åben — samtalen
# begynder ved at trykke på en båd på kortet.
SEJLPLAN_BESKEDER=fra
