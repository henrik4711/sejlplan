# ── Sejlplan konfiguration ────────────────────────────────
# Kopier denne fil til ".env" og udfyld værdierne.
# .env må ALDRIG committes til git (den står i .gitignore).

# Anthropic API-nøgle til AI-sejlanalysen.
# Hentes på https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model der bruges til analysen.
SEJLPLAN_AI_MODEL=claude-opus-5

# Hemmelighed der signerer browser-sessioner. Skal være en lang,
# tilfældig streng. Skift den, og alle brugere logges "ud" af deres
# gemte indstillinger.
SEJLPLAN_STORAGE_SECRET=skift-mig-til-noget-langt-og-tilfaeldigt

# Netværk
SEJLPLAN_HOST=0.0.0.0
SEJLPLAN_PORT=8090

# Kontakt-mail sendt med i User-Agent til OpenStreetMap Nominatim
# (deres brugsvilkår kræver en identificerbar afsender).
SEJLPLAN_CONTACT=din@mail.dk
